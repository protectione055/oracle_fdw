   ->  Foreign Scan on direct_test
         Oracle query: SELECT /*d9e4ccd3aa05db65*/ r1."ID", r1."VAL", r1."TXT", r1.ROWID FROM "SCOTT"."DIRECT_TEST" r1 FOR UPDATE
(4 rows)

